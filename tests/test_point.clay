// Tests for Point. Run them from anywhere in the Clay checkout:
//   clay tests/test_point.clay
//
// They use stdlib/test, which comes with Clay:
//   Test describe("name") { ... }   groups tests (groups can nest)
//   Test it("name") { ... }         one test: it fails if anything in it raises
//   Test assertEqual(actual, expected), assertNotEqual, assertTrue / assertFalse
//                                   (exactly true / false), and
//   Test assertRaises({ ... }, "ErrorType") check a result; each raises on failure
//   Test run                        prints the summary, exits with status 1 if
//                                   any test failed (so CI sees it)
// Each `it` block is its own block: a variable made in one test isn't seen in
// the next, so every test builds the points it needs.
//
// Vector's own methods are tested in test_vector.clay.
import("point")
import("stdlib/test")

// Floats are 32-bit, so compare computed ones with a tolerance
near = { |a, b| ((a - b) abs) < 0.0001 }

Test describe("Point") {
    Test describe("new") {
        Test it("makes a Point") {
            Test assertEqual(Point new(1, 2) type, "Point")
        }

        Test it("sets x and y") {
            p = Point new(3, 4)
            Test assertEqual(p getX, 3)
            Test assertEqual(p getY, 4)
        }

        Test it("takes floats and negative numbers") {
            p = Point new(1.5, -2)
            Test assertEqual(p getX, 1.5)
            Test assertEqual(p getY, -2)
        }

        Test it("rejects anything but numbers") {
            e = Test assertRaises({ Point new("a", 2) })
            Test assertEqual(e message, "Point:new expects numbers")
            Test assertRaises({ Point new(1, nil) })
            Test assertRaises({ Point new })
        }

        Test it("leaves the prototype at the origin") {
            Point new(5, 6)
            Test assertEqual(Point getX, 0)
            Test assertEqual(Point getY, 0)
        }
    }

    Test describe("accessors") {
        Test it("setX and setY change the point and return it") {
            p = Point new(1, 2)
            Test assertTrue((p setX(7)) == p)
            p setY(8)
            Test assertEqual(p, Point new(7, 8))
        }

        Test it("chain") {
            Test assertEqual(Point new(0, 0) setX(1) setY(2), Point new(1, 2))
        }

        Test it("x and y are also plain slots") {
            p = Point new(1, 2)
            Test assertEqual(p x, 1)
            p y = 9
            Test assertEqual(p getY, 9)
        }

        Test it("copy is equal but separate") {
            p = Point new(1, 2)
            q = p copy
            Test assertEqual(q, p)
            q setX(5)
            Test assertEqual(p getX, 1)
        }
    }

    Test describe("equality") {
        Test it("== compares coordinates") {
            Test assertTrue(Point new(1, 2) == Point new(1, 2))
            Test assertFalse(Point new(1, 2) == Point new(2, 1))
        }

        Test it("!= is the opposite of ==") {
            Test assertFalse(Point new(1, 2) != Point new(1, 2))
            Test assertTrue(Point new(1, 2) != Point new(1, 3))
        }

        Test it("is never equal to something that is not a point") {
            p = Point new(1, 2)
            Test assertFalse(p == nil)
            Test assertFalse(p == 1)
            Test assertFalse(p == "Point(1, 2)")
            Test assertFalse(p == Vector new(1, 2))
            Test assertTrue(p != nil)
        }

        Test it("works with assertEqual") {
            Test assertEqual(Point new(1, 2), Point new(1, 2))
            Test assertNotEqual(Point new(1, 2), Point new(0, 0))
        }
    }

    Test describe("arithmetic") {
        Test it("Point - Point is the Vector between them") {
            d = Point new(4, 7) - Point new(1, 2)
            Test assertEqual(d type, "Vector")
            Test assertEqual(d, Vector new(3, 5))
        }

        Test it("Point + Vector is a Point") {
            p = Point new(1, 2) + Vector new(3, 5)
            Test assertEqual(p type, "Point")
            Test assertEqual(p, Point new(4, 7))
        }

        Test it("Point - Vector is a Point") {
            p = Point new(4, 7) - Vector new(3, 5)
            Test assertEqual(p type, "Point")
            Test assertEqual(p, Point new(1, 2))
        }

        Test it("a + (b - a) is b") {
            a = Point new(1, 2)
            b = Point new(6, -3)
            Test assertEqual(a + (b - a), b)
        }

        Test it("two points cannot be added") {
            e = Test assertRaises({ Point new(1, 2) + Point new(3, 4) })
            Test assertEqual(e message, "Point +: expects a Vector")
            Test assertRaises({ Point new(1, 2) + 1 })
        }

        Test it("- needs a point or a vector") {
            e = Test assertRaises({ Point new(1, 2) - 1 })
            Test assertEqual(e message, "Point -: expects a Point or a Vector")
        }

        Test it("operators return new objects and leave their operands alone") {
            a = Point new(1, 2)
            v = Vector new(3, 4)
            a + v
            a - v
            a - Point new(0, 0)
            Test assertEqual(a, Point new(1, 2))
            Test assertEqual(v, Vector new(3, 4))
        }
    }

    Test describe("distance") {
        Test it("distance") {
            Test assertEqual(Point new(1, 1) distance(Point new(4, 5)), 5)
            Test assertEqual(Point new(2, 3) distance(Point new(2, 3)), 0)
        }

        Test it("distanceSquared avoids sqrt") {
            Test assertEqual(Point new(0, 0) distanceSquared(Point new(3, 4)), 25)
            Test assertEqual(Point new(1, 1) distanceSquared(Point new(4, 5)), 25)
            Test assertEqual(Point new(2, 3) distanceSquared(Point new(2, 3)), 0)
        }

        Test it("need a point") {
            Test assertRaises({ Point new(1, 1) distance(Vector new(4, 5)) })
            Test assertRaises({ Point new(1, 1) distanceSquared(nil) })
        }
    }

    Test describe("lerp and midpoint") {
        Test it("lerp goes part of the way") {
            a = Point new(0, 0)
            b = Point new(10, 20)
            Test assertEqual(a lerp(b, 0), a)
            Test assertEqual(a lerp(b, 1), b)
            Test assertEqual(a lerp(b, 0.5), Point new(5, 10))
        }

        Test it("lerp returns a Point") {
            Test assertEqual(Point new(0, 0) lerp(Point new(2, 2), 0.5) type, "Point")
        }

        Test it("lerp needs a point") {
            Test assertRaises({ Point new(0, 0) lerp(Vector new(1, 1), 0.5) })
        }

        Test it("midpoint is halfway") {
            Test assertEqual(Point new(0, 0) midpoint(Point new(10, 20)), Point new(5, 10))
            Test assertEqual(Point new(-2, 4) midpoint(Point new(2, 0)), Point new(0, 2))
        }
    }

    Test describe("orientation") {
        Test it("is positive for a counterclockwise turn") {
            a = Point new(0, 0)
            Test assertEqual(a orientation(Point new(1, 0), Point new(0, 1)), 1)
        }

        Test it("is negative for a clockwise turn") {
            a = Point new(0, 0)
            Test assertEqual(a orientation(Point new(0, 1), Point new(1, 0)), -1)
        }

        Test it("is zero for points in a line") {
            a = Point new(0, 0)
            Test assertEqual(a orientation(Point new(1, 1), Point new(3, 3)), 0)
        }
    }

    Test describe("conversion") {
        Test it("toVector is the offset from the origin") {
            v = Point new(3, 4) toVector
            Test assertEqual(v type, "Vector")
            Test assertEqual(v, Vector new(3, 4))
            Test assertEqual(v length, 5)
        }

        Test it("toVector and toPoint round-trip") {
            p = Point new(3, 4)
            Test assertEqual(p toVector toPoint, p)
        }

        Test it("toVector gives an independent vector") {
            p = Point new(3, 4)
            v = p toVector
            v x = 9
            Test assertEqual(p getX, 3)
        }
    }

    Test describe("toString") {
        Test it("shows the coordinates") {
            Test assertEqual(Point new(1, 2) toString, "Point(1, 2)")
            Test assertEqual(Point new(1.5, -2) toString, "Point(1.5, -2)")
        }

        Test it("is used by string interpolation") {
            p = Point new(3, 4)
            Test assertEqual("at ${p}", "at Point(3, 4)")
        }
    }
}

// run the test cases
Test run
